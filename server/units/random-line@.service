# One ingestion pass of one line, run by its timer. The instance name is the
# line: random-line@daily-auto-morning, random-line@video-enrich…
# Never two passes of the same line at once (flock), never longer than
# RuntimeMaxSec: what the GitHub jobs allowed, so the server behaves the same.
[Unit]
Description=RANDOM ingestion line %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=random
Group=random
WorkingDirectory=/opt/random-app
Environment=NODE_ENV=production
Environment=HOME=/home/random
# A line whose lock is held — by its previous pass, or by the small model's window holding the captures' — skips its turn:
# flock says so with 75, which is a skip, not a failure (the captures showed "failed" whenever the model ran, October).
ExecStart=/usr/bin/flock -n -E 75 /home/random/locks/%i.lock /bin/bash /opt/random-app/server/run-line.sh %i
SuccessExitStatus=75
RuntimeMaxSec=3900
Nice=10
MemoryMax=700M
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/random-app /home/random
