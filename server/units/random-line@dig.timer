[Unit]
Description=RANDOM dig (six runs a day, Paris: the three morning-afternoon ones with YouTube, the others on Dailymotion and the channels met; the day's YouTube units shared)

[Timer]
OnCalendar=*-*-* 09:30:00 Europe/Paris
OnCalendar=*-*-* 11:30:00 Europe/Paris
OnCalendar=*-*-* 13:30:00 Europe/Paris
OnCalendar=*-*-* 16:00:00 Europe/Paris
OnCalendar=*-*-* 18:30:00 Europe/Paris
OnCalendar=*-*-* 21:30:00 Europe/Paris
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
