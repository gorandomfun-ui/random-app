# Enable only after verifying the standard Dailymotion player without Infopack/TCF.
# Missing or 0: media permission required. 1: conditional standard path allowed.
# NEXT_PUBLIC changes require rebuilding the client.
NEXT_PUBLIC_RANDOM_DM_STANDARD_PLAYBACK=0

# RANDOM ARCADE — the two games between two contents (lib/games/flow.ts).
# 1: the games come up in the Random flow. Missing or 0: the Random page is exactly as without them.
# NEXT_PUBLIC changes require rebuilding the client.
NEXT_PUBLIC_GAMES_ENABLED=0
# The first offer at so many images and videos seen on the device, wherever the rhythm stands (default 20);
# after each refusal in a row, so many more (default 30,40,60,140,300: offers at 20, 50, 90, 150, 290, 590, then none);
# the next level after a level won / lost (defaults 10 / 20).
# NEXT_PUBLIC_GAMES_FIRST=20
# NEXT_PUBLIC_GAMES_LADDER=30,40,60,140,300
# NEXT_PUBLIC_GAMES_AFTER_WIN=10
# NEXT_PUBLIC_GAMES_AFTER_LOSS=20
# Server key that signs a game's ticket for the world's scores. Missing: a key derived from MONGODB_URI.
# GAMES_SCORE_SECRET=
